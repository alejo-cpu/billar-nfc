/* ============ placa superior ============ */
.placa {
  position: relative;
  width: 90%;
  background: linear-gradient(145deg, #202126 0%, #0d0e12 48%, #090a0d 100%);
  border: 1px solid rgba(240, 201, 40, .25);
  border-radius: 28px;
  padding: 28px 22px 26px;
  box-shadow: 0 20px 50px rgba(0, 0, 0, .6), inset 0 1px 0 rgba(255, 255, 255, .06);
  text-align: center;
  flex: none;
  margin-top: 8px;
}

.placa::before, .placa::after {
  content: "";
  position: absolute;
  top: 50%;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--hdp);
  box-shadow: 0 0 12px rgba(240, 201, 40, .7);
}

.placa::before {
  left: 16px;
}

.placa::after {
  right: 16px;
}

.placa .tagline {
  font-size: 22px;
  letter-spacing: 3px;
  color: #a9a79f;
  text-transform: uppercase;
  margin-top: 8px;
}

.placa .plabel {
  font-family: var(--f-pixel);
  font-size: 16px;
  letter-spacing: 3px;
  color: var(--hdp);
  margin-top: 20px;
  margin-bottom: 8px;
  text-transform: uppercase;
}

.logo {
  display: block;
  width: 250px;
  max-height: 190px;
  object-fit: contain;
  margin: 0 auto;
  filter: drop-shadow(0 0 22px rgba(240, 201, 40, .18));
}

/* ============ textos ============ */
.kicker {
  font-family: var(--f-pixel);
  font-size: 16px;
  letter-spacing: 2.5px;
  color: var(--muted);
  text-transform: uppercase;
