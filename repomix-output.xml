@font-face {
  font-family: 'Inter';
  src: url('../fonts/inter.woff2') format('woff2');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: 'Press Start 2P';
  src: url('../fonts/press-start-2p.woff2') format('woff2');
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

:root {
  --hdp: #f0c928;
  --hdp-soft: #fff1a8;
  --panel2: #0c0e12;
  --line: #2a2d33;
  --text: #f3f1e9;
  --muted: #90949d;
  --red: #f65b5b;
  --green: #37d67a;
  --f-body: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
  --f-pixel: 'Press Start 2P', ui-monospace, 'Courier New', monospace;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html, body, #root {
  height: 100%;
}

body {
  background: radial-gradient(circle at 50% 5%, #26231a 0%, #101014 35%, #050607 75%, #020203 100%);
  color: var(--text);
  font-family: var(--f-body);
  -webkit-font-smoothing: antialiased;
  -webkit-user-select: none;
  user-select: none;
  overflow: hidden;
}

.stage {
  height: 100vh;
  height: 100dvh;
  overflow: hidden;
  display: flex;
  justify-content: center;
  padding: 8px 12px 8px;
}

.frame {
  height: 100%;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.screen {
  width: 100%;
  height: 100%;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  /*animation: fadeIn .4s ease-out both;*/
}

.screen.home {
  justify-content: center;
}

.screen.detail {
  justify-content: flex-start;
  padding-top: 8px;
}

