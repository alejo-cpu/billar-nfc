    opacity: .6;
  }
  50% {
    transform: translateY(14px);
    opacity: 1;
  }
}

/* ============ pantalla de detalle ============ */
.type-pill {
  display: inline-block;
  margin-top: 14px;
  margin-bottom: 12px;
  padding: 10px 22px;
  border: 1px solid var(--hdp);
  border-radius: 999px;
