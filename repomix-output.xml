            <button type="button" id="btnSubmitTaco" class="btn" onclick="saveTaco()">Guardar Taco</button>
          </div>
        </form>
      </div>

      <div class="preview-col">
        <div class="preview-box-container">
          <div id="tacoPreviewCanvas" class="preview-scaler-inner"></div>
        </div>
      </div>
    </div>
  </div>

  <script>
    let TOKEN = localStorage.getItem('HDP_ADMIN_TOKEN') || '';
    let PERMISOS = JSON.parse(localStorage.getItem('HDP_PERMISOS') || '{"crear":true,"editar":true,"eliminar":true,"categorias":true,"rol":"admin"}');
    let CATEGORIAS = [];
    let TACOS = [];

    if (TOKEN) {
      document.getElementById('loginGate').classList.remove('active');
      document.getElementById('adminApp').style.display = 'block';
      applyPermissions();
      loadData();
    }

    function showToast(msg, type = 'success') {
      const c = document.getElementById('toastContainer');
      const t = document.createElement('div');
      t.className = `toast ${type}`;
      t.innerText = msg;
      c.appendChild(t);
      setTimeout(() => {
        t.style.opacity = '0';
        setTimeout(() => t.remove(), 200);
      }, 3500);
    }

    function parseErrorMessage(err) {
      if (!err) return 'Error desconocido';
      if (Array.isArray(err.detail)) {
        return err.detail.map(d => d.msg ? d.msg.replace(/^Value error,\s*/i, '') : JSON.stringify(d)).join('. ');
      }
      if (typeof err.detail === 'string') return err.detail;
      return 'Error en los datos ingresados';
    }

    function validateUIDInput(input) {
      input.value = input.value.replace(/[^0-9a-fA-F]/g, '').toLowerCase();
    }

    function validateNumeroInput(input) {
      input.value = input.value.replace(/[^0-9]/g, '');
    }

    function calculateNextNumber() {
      const existing = new Set();
      TACOS.forEach(t => {
        const n = parseInt(t.numero, 10);
        if (!isNaN(n)) existing.add(n);
      });
      let n = 1;
      while (existing.has(n)) {
        n++;
      }
      return n < 10 ? '0' + n : String(n);
    }

    async function doLogin() {
      const pass = document.getElementById('adminPasswordInput').value;
      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({password: pass})
        });
        if (!res.ok) throw new Error();
        const data = await res.json();
        TOKEN = data.token;
        PERMISOS = data.permisos;
        localStorage.setItem('HDP_ADMIN_TOKEN', TOKEN);
        localStorage.setItem('HDP_PERMISOS', JSON.stringify(PERMISOS));
        document.getElementById('loginGate').classList.remove('active');
        document.getElementById('adminApp').style.display = 'block';
        applyPermissions();
        loadData();
      } catch (e) {
        document.getElementById('loginError').style.display = 'block';
      }
    }

    function applyPermissions() {
      document.getElementById('userBadge').innerText = `Rol: ${PERMISOS.rol.toUpperCase()}`;
      if (!PERMISOS.crear) document.getElementById('btnTacoModal').style.display = 'none';
      if (!PERMISOS.categorias) {
        document.getElementById('btnEditCats').style.display = 'none';
        document.getElementById('btnNewCat').style.display = 'none';
      }
    }

    async function loadData() {
      const [catsRes, cuesRes] = await Promise.all([
        fetch('/api/categorias'),
        fetch('/api/tacos')
      ]);
      CATEGORIAS = await catsRes.json();
      TACOS = await cuesRes.json();
      populateCategorySelects();
      renderCues();
      renderCatList();
    }

    function populateCategorySelects() {
      const filter = document.getElementById('filterCategory');
      const formSel = document.getElementById('f_categoria');
      filter.innerHTML = '<option value="ALL">Todas las Categorías</option>';
      formSel.innerHTML = '';
      
      CATEGORIAS.forEach(c => {
        filter.innerHTML += `<option value="${c.id}">${c.nombre}</option>`;
        formSel.innerHTML += `<option value="${c.id}">${c.nombre}</option>`;
      });
    }

    function onCategorySelectChange() {
      const catId = document.getElementById('f_categoria').value;
      const cat = CATEGORIAS.find(c => c.id === catId);
      if (cat) {
        document.getElementById('f_peso').value = cat.peso_default || 3;
        document.getElementById('val_peso').innerText = cat.peso_default || 3;
        document.getElementById('f_agilidad').value = cat.agilidad_default || 3;
        document.getElementById('val_agilidad').innerText = cat.agilidad_default || 3;
        if (!document.getElementById('f_golpe').value) document.getElementById('f_golpe').value = cat.golpe_default || 'Equilibrado';
        if (!document.getElementById('f_sens_texto').value) document.getElementById('f_sens_texto').value = cat.sensacion_texto_default || 'Natural y estable';
      }
      updateTacoPreview();
    }

    function renderCues() {
      const q = document.getElementById('searchInput').value.toLowerCase().trim();
      const cat = document.getElementById('filterCategory').value;
      const list = document.getElementById('cuesList');
      
      const filtered = TACOS.filter(t => {
        const matchesQ = t.numero.toLowerCase().includes(q) || t.nfc_uid.toLowerCase().includes(q);
        const matchesCat = (cat === 'ALL' || t.categoria_id === cat);
        return matchesQ && matchesCat;
      });

      if (filtered.length === 0) {
        list.innerHTML = '<p style="text-align: center; color: var(--muted); margin-top: 36px;">No se encontraron tacos con ese criterio.</p>';
        return;
      }

      list.innerHTML = filtered.map(t => `
        <div class="cue-card">
          <div class="cue-left">
            <div class="cue-num">#${t.numero}</div>
            <div>
              <span class="badge" style="border-color: ${t.cat_color}; color: ${t.cat_color};">${t.cat_nombre}</span>
              <div class="cue-uid">${t.nfc_uid}</div>
            </div>
          </div>
          <div class="actions">
            ${PERMISOS.editar ? `<button class="btn btn-secondary" onclick="editTaco('${t.nfc_uid}')">Editar</button>` : ''}
            ${PERMISOS.eliminar ? `<button class="btn btn-danger" onclick="promptDeleteTaco('${t.nfc_uid}', '${t.numero}')">✕</button>` : ''}
          </div>
        </div>
      `).join('');
    }

    function openTacoModal(isEdit = false) {
      document.getElementById('tacoModalTitle').innerText = isEdit ? 'Editar Taco' : 'Nuevo Taco';
      document.getElementById('f_uid').readOnly = isEdit;
      document.getElementById('tacoModal').classList.add('active');
      if (!isEdit) {
        document.getElementById('tacoForm').reset();
        document.getElementById('f_numero').value = calculateNextNumber();
        document.getElementById('val_peso').innerText = '3';
        document.getElementById('val_agilidad').innerText = '3';
        onCategorySelectChange();
      }
      updateTacoPreview();
    }

    function openNewCategoryModal() {
      document.getElementById('catEditModalTitle').innerText = 'Nueva Categoría';
      document.getElementById('catForm').reset();
      document.getElementById('c_id').readOnly = false;
      document.getElementById('val_c_peso').innerText = '3';
      document.getElementById('val_c_agilidad').innerText = '3';
      document.getElementById('catEditModal').classList.add('active');
      updateCatPreview();
    }

    function openCategoriesManager() {
      renderCatList();
      document.getElementById('catManagerModal').classList.add('active');
    }

    function closeModals() {
      document.querySelectorAll('.modal-overlay:not(#loginGate):not(#deleteModal)').forEach(m => m.classList.remove('active'));
    }

    function closeDeleteModal() {
      document.getElementById('deleteModal').classList.remove('active');
    }

    function openMobilePreview(type) {
      if (type === 'taco') updateTacoPreview();
      else updateCatPreview();

      const source = type === 'taco'
        ? document.getElementById('tacoPreviewCanvas').innerHTML
        : document.getElementById('catPreviewCanvas').innerHTML;

      document.getElementById('mobilePreviewCanvas').innerHTML = source;
      document.getElementById('mobilePreviewModal').classList.add('active');
    }

    function closeMobilePreview() {
      document.getElementById('mobilePreviewModal').classList.remove('active');
    }

    function editTaco(uid) {
      const t = TACOS.find(x => x.nfc_uid === uid);
      if (!t) return;
      document.getElementById('f_uid').value = t.nfc_uid;
      document.getElementById('f_numero').value = t.numero;
      document.getElementById('f_categoria').value = t.categoria_id;
      document.getElementById('f_peso').value = t.peso;
      document.getElementById('val_peso').innerText = t.peso;
      document.getElementById('f_agilidad').value = t.agilidad;
      document.getElementById('val_agilidad').innerText = t.agilidad;
      document.getElementById('f_golpe').value = t.golpe || '';
      document.getElementById('f_sens_texto').value = t.sensacion_texto || '';
      document.getElementById('f_desc_custom').value = t.descripcion_custom || '';
      document.getElementById('f_ideal_custom').value = t.ideal_custom || '';
      openTacoModal(true);
    }

    async function saveTaco() {
      const uid = document.getElementById('f_uid').value.trim();
      const isEdit = document.getElementById('f_uid').readOnly;
      const numInput = document.getElementById('f_numero').value.trim();
      
      const payload = {
        nfc_uid: uid,
        numero: numInput ? numInput : calculateNextNumber(),
        categoria_id: document.getElementById('f_categoria').value,
        peso: parseInt(document.getElementById('f_peso').value),
        agilidad: parseInt(document.getElementById('f_agilidad').value),
        golpe: document.getElementById('f_golpe').value.trim() || 'Equilibrado',
        sensacion_texto: document.getElementById('f_sens_texto').value.trim() || 'Natural y estable',
        descripcion_custom: document.getElementById('f_desc_custom').value.trim() || null,
        ideal_custom: document.getElementById('f_ideal_custom').value.trim() || null
      };

      try {
        const res = await fetch(isEdit ? `/api/tacos/${uid}` : '/api/tacos', {
          method: isEdit ? 'PUT' : 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Admin-Password': TOKEN
          },
          body: JSON.stringify(payload)
        });

        if (!res.ok) {
          const err = await res.json();
          showToast(parseErrorMessage(err), 'error');
          return;
        }

        showToast(isEdit ? 'Taco actualizado' : 'Taco creado con éxito');
        closeModals();
        loadData();
      } catch (err) {
        showToast('Error de conexión con el servidor', 'error');
      }
    }

    function promptDeleteTaco(uid, num) {
      document.getElementById('deleteMessage').innerText = `¿Seguro que deseas eliminar el Taco #${num} con UID ${uid}?`;
      document.getElementById('btnConfirmDelete').onclick = async () => {
        const res = await fetch(`/api/tacos/${uid}`, {
          method: 'DELETE',
          headers: {'X-Admin-Password': TOKEN}
        });
        if (res.ok) {
          showToast('Taco eliminado');
          closeDeleteModal();
          loadData();
        } else {
          showToast('Error al eliminar taco', 'error');
        }
      };
      document.getElementById('deleteModal').classList.add('active');
    }

    function renderCatList() {
      const container = document.getElementById('catListContainer');
      container.innerHTML = CATEGORIAS.map(c => `
        <div style="display: flex; justify-content: space-between; align-items: center; background: var(--panel2); border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px;">
          <div style="display: flex; align-items: center; gap: 10px;">
            <span style="width: 14px; height: 14px; border-radius: 50%; background: ${c.color};"></span>
            <div>
              <b>${c.nombre}</b> <span style="font-size: 11px; color: var(--muted);">${c.tagline}</span>
            </div>
          </div>
          <div style="display: flex; gap: 8px; align-items: center;">
            ${c.es_estandar ? `
              <span style="font-size: 11px; color: var(--muted); padding: 4px 8px; border: 1px solid var(--line); border-radius: 6px;">Fija / Estándar</span>
            ` : `
              <button class="btn btn-danger" style="padding: 5px 9px; font-size: 12px;" onclick="promptDeleteCategory('${c.id}', '${c.nombre}')">✕ Eliminar</button>
              <button class="btn btn-secondary" style="padding: 5px 12px; font-size: 12px;" onclick="loadCatToForm('${c.id}')">Editar</button>
            `}
          </div>
        </div>
      `).join('');
    }

    function loadCatToForm(id) {
      const c = CATEGORIAS.find(x => x.id === id);
      if (!c || c.es_estandar) return;
      document.getElementById('c_id').value = c.id;
      document.getElementById('c_id').readOnly = true;
      document.getElementById('c_nombre').value = c.nombre.toUpperCase();
      document.getElementById('c_color').value = c.color;
      document.getElementById('c_tagline').value = c.tagline;
      document.getElementById('c_desc').value = c.descripcion_default;
      document.getElementById('c_ideal').value = c.ideal_default;
      document.getElementById('c_peso').value = c.peso_default || 3;
      document.getElementById('val_c_peso').innerText = c.peso_default || 3;
      document.getElementById('c_agilidad').value = c.agilidad_default || 3;
      document.getElementById('val_c_agilidad').innerText = c.agilidad_default || 3;
      document.getElementById('c_golpe').value = c.golpe_default || 'Equilibrado';
      document.getElementById('c_sens_texto').value = c.sensacion_texto_default || 'Natural y estable';
      document.getElementById('catEditModalTitle').innerText = 'Editar Categoría: ' + c.nombre;
      
      closeModals();
      document.getElementById('catEditModal').classList.add('active');
      updateCatPreview();
    }

    async function saveCategory() {
      const desc = document.getElementById('c_desc').value.trim();
      const payload = {
        id: document.getElementById('c_id').value.toUpperCase().trim(),
        nombre: document.getElementById('c_nombre').value.toUpperCase().trim(),
        color: document.getElementById('c_color').value,
        tagline: document.getElementById('c_tagline').value.trim(),
        descripcion_default: desc,
        ideal_default: document.getElementById('c_ideal').value.trim(),
        other_text: desc,
        peso_default: parseInt(document.getElementById('c_peso').value),
        agilidad_default: parseInt(document.getElementById('c_agilidad').value),
        golpe_default: document.getElementById('c_golpe').value.trim() || 'Equilibrado',
        sensacion_texto_default: document.getElementById('c_sens_texto').value.trim() || 'Natural y estable',
        es_estandar: 0
      };

      try {
        const res = await fetch('/api/categorias', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Admin-Password': TOKEN
          },
          body: JSON.stringify(payload)
        });

        if (!res.ok) {
          const err = await res.json();
          showToast(parseErrorMessage(err), 'error');
          return;
        }

        showToast('Categoría guardada con éxito');
        closeModals();
        loadData();
      } catch (err) {
        showToast('Error de conexión al guardar categoría', 'error');
      }
    }

    function promptDeleteCategory(id, nombre) {
      document.getElementById('deleteMessage').innerText = `¿Seguro que deseas eliminar la categoría "${nombre}" (${id})?`;
      document.getElementById('btnConfirmDelete').onclick = async () => {
        try {
          const res = await fetch(`/api/categorias/${id}`, {
            method: 'DELETE',
            headers: {'X-Admin-Password': TOKEN}
          });
          if (res.ok) {
            showToast('Categoría eliminada');
            closeDeleteModal();
            loadData();
          } else {
            const err = await res.json();
            showToast(parseErrorMessage(err), 'error');
          }
        } catch (err) {
          showToast('Error de conexión', 'error');
        }
      };
      document.getElementById('deleteModal').classList.add('active');
    }

    if ('NDEFReader' in window) {
      const btn = document.getElementById('btnWebNFC');
      if (btn) btn.style.display = 'inline-flex';
    }

    async function scanWebNFC() {
      try {
        const ndef = new NDEFReader();
        await ndef.scan();
        ndef.onreading = event => {
          document.getElementById('f_uid').value = event.serialNumber.replace(/:/g, '').toLowerCase();
          updateTacoPreview();
        };
      } catch (err) {
        showToast('NFC no disponible: ' + err, 'error');
      }
    }

    function renderKioskTemplate(num, cat, peso, agilidad, golpe, sensTxt, desc, ideal) {
      let sug1, sug2;
      if (cat.es_estandar) {
        const others = CATEGORIAS.filter(c => c.es_estandar && c.id !== cat.id);
        sug1 = others[0] || cat;
        sug2 = others[1] || cat;
      } else {
        const heaviness = ((peso + (6 - agilidad) - 2) / 8) * 100;
        const light = CATEGORIAS.find(c => c.id === 'LIGHT') || cat;
        const balanced = CATEGORIAS.find(c => c.id === 'BALANCED') || cat;
        const power = CATEGORIAS.find(c => c.id === 'POWER') || cat;
        if (heaviness > 70) {
          sug1 = light; sug2 = balanced;
        } else if (heaviness >= 40) {
          sug1 = light; sug2 = power;
        } else {
          sug1 = balanced; sug2 = power;
        }
      }

      const dots = v => [1,2,3,4,5].map(i => `<span class="dot ${i <= v ? 'on' : ''}" style="${i <= v ? `background: ${cat.color};` : ''}"></span>`).join('');

      return `
        <div class="placa" style="width: 100%; padding: 18px 16px; border-radius: 20px;">
          <img src="img/logo.webp" alt="Logo" class="logo" style="width: 190px; max-height: 120px;">
          <div class="tagline" style="font-size: 16px; margin-top: 4px;">THE GOOD PLACE OF BILLIARDS</div>
          <div class="plabel" style="font-size: 13px; margin-top: 10px;">IDENTIFICADOR</div>
        </div>

        <div class="kicker" style="font-size: 14px; margin-top: 12px;">TACO ${num}</div>
        <div class="type-pill" style="border-color: ${cat.color}; color: ${cat.color}; font-size: 14px; padding: 6px 18px; margin-top: 8px;">${cat.nombre}</div>
        <div class="type-tag" style="font-size: 15px; margin-top: 4px;">${cat.tagline}</div>
        <p class="desc" style="font-size: 14px; max-width: 95%; margin-top: 10px; line-height: 1.45;">${desc}</p>

        <div class="stats" style="width: 100%; padding: 14px 16px; border-radius: 14px; margin-top: 12px;">
          <div class="srow">
            <div class="scell">
              <div class="lab" style="font-size: 11px;">PESO</div>
              <div class="dots" style="margin-top: 6px;">${dots(peso)}</div>
            </div>
            <div class="scell">
              <div class="lab" style="font-size: 11px;">AGILIDAD</div>
              <div class="dots" style="margin-top: 6px;">${dots(agilidad)}</div>
            </div>
          </div>
          <div class="srow">
            <div class="scell">
              <div class="lab" style="font-size: 11px;">GOLPE</div>
              <div class="val" style="font-size: 14px; margin-top: 4px;">${golpe}</div>
            </div>
            <div class="scell">
              <div class="lab" style="font-size: 11px;">SENSACIÓN</div>
              <div class="val" style="font-size: 14px; margin-top: 4px;">${sensTxt}</div>
            </div>
          </div>
          <div class="scell full">
            <div class="lab" style="font-size: 11px;">IDEAL PARA</div>
            <div class="val soft" style="font-size: 13px; margin-top: 4px;">${ideal}</div>
          </div>
        </div>

        <div class="divider" style="margin: 12px auto; width: 60px;"></div>
        <div class="other-title" style="font-size: 15px; margin-bottom: 6px;">¿Buscas otra sensación?</div>
        <div class="sens-grid" style="width: 100%; gap: 8px;">
          <div class="sens" style="border-left-color: ${sug1.color}; padding: 10px 12px; border-radius: 10px;">
            <b style="font-size: 14px;"><span class="odot" style="background: ${sug1.color}; width: 8px; height: 8px;"></span>${sug1.nombre}</b>
            <small style="font-size: 12px; margin-top: 2px;">${sug1.other_text || sug1.descripcion_default}</small>
          </div>
          <div class="sens" style="border-left-color: ${sug2.color}; padding: 10px 12px; border-radius: 10px;">
            <b style="font-size: 14px;"><span class="odot" style="background: ${sug2.color}; width: 8px; height: 8px;"></span>${sug2.nombre}</b>
            <small style="font-size: 12px; margin-top: 2px;">${sug2.other_text || sug2.descripcion_default}</small>
          </div>
        </div>

        <div class="divider" style="margin: 12px auto; width: 60px;"></div>
        <p class="hint" style="font-size: 14px; margin-top: 6px;">¿No sabés cuál elegir? Empezá por <b>BALANCED</b>.</p>
        <div class="foot" style="font-size: 10px; margin-top: 10px;">HDP BILLAR · EST. 1985</div>
      `;
    }

    function updateTacoPreview() {
      const numInput = document.getElementById('f_numero').value.trim();
      const num = numInput ? numInput : calculateNextNumber();
      const catId = document.getElementById('f_categoria').value;
      const cat = CATEGORIAS.find(c => c.id === catId) || CATEGORIAS[0] || {
        nombre: 'CATEGORÍA', color: '#f0c928', tagline: 'Sensación', descripcion_default: 'Descripción...', ideal_default: 'Jugadores...'
      };
      const peso = parseInt(document.getElementById('f_peso').value);
      const agilidad = parseInt(document.getElementById('f_agilidad').value);
      const golpe = document.getElementById('f_golpe').value || 'Equilibrado';
      const sensTxt = document.getElementById('f_sens_texto').value || 'Natural y estable';
      const desc = document.getElementById('f_desc_custom').value.trim() || cat.descripcion_default;
      const ideal = document.getElementById('f_ideal_custom').value.trim() || cat.ideal_default;

      document.getElementById('tacoPreviewCanvas').innerHTML = renderKioskTemplate(num, cat, peso, agilidad, golpe, sensTxt, desc, ideal);
    }

    function updateCatPreview() {
      const cat = {
        nombre: (document.getElementById('c_nombre').value || 'NUEVA').toUpperCase(),
        color: document.getElementById('c_color').value || '#9b51e0',
        tagline: document.getElementById('c_tagline').value || 'Firmeza Premium · Grafito',
        descripcion_default: document.getElementById('c_desc').value || 'Descripción predeterminada del taco...',
        ideal_default: document.getElementById('c_ideal').value || 'Jugadores experimentados...'
      };
      const peso = parseInt(document.getElementById('c_peso').value) || 3;
      const agilidad = parseInt(document.getElementById('c_agilidad').value) || 3;
      const golpe = document.getElementById('c_golpe').value || 'Contundente';
      const sensTxt = document.getElementById('c_sens_texto').value || 'Firme y sólida';

      document.getElementById('catPreviewCanvas').innerHTML = renderKioskTemplate('99', cat, peso, agilidad, golpe, sensTxt, cat.descripcion_default, cat.ideal_default);
    }
  </script>
</body>
</html>
</file>

