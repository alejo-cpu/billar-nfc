}

.hint {
  font-size: 20px;
  color: var(--muted);
  margin-top: 12px;
}

.hint b {
  color: var(--hdp);
}

.foot {
  margin-top: 28px;
  font-family: var(--f-pixel);
  font-size: 11px;
  letter-spacing: 3.5px;
  color: #6f7075;
  text-transform: uppercase;
}

/* ============ leyendo ============ */
.reading {
  justify-content: center;
}

.ringwrap {
  margin-top: 40px;
  position: relative;
  width: 104px;
  height: 104px;
}

.nfc {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 64px;
  height: 64px;
  transform: translate(-50%, -50%);
  color: var(--hdp);
  filter: drop-shadow(0 0 12px rgba(240, 201, 40, .45));
  animation: textPulse .4s ease-in-out infinite;
}

.ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 4px solid rgba(240, 201, 40, .22);
  border-top-color: var(--hdp);
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.reading-txt {
  margin-top: 22px;
  font-size: 20px;
  color: var(--hdp);
  letter-spacing: .08em;
  animation: textPulse 1.4s ease-in-out infinite;
}

@keyframes textPulse {
  0%, 100% {
    opacity: .55;
  }
  50% {
    opacity: 1;
  }
}



/* ============ standby ============ */
.sleep {
  position: fixed;
  inset: 0;
  z-index: 50;
  background: #000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 1.6s ease;
}

.standby .sleep {
  opacity: 1;
}

.standby * {
  animation-play-state: paused !important;
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition: none !important;
  }
}
